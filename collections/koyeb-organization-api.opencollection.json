            "url": "{{baseUrl}}/v1/unscope_organization_token",
            "headers": [
              {
                "name": "seon-fp",
                "value": ""
              }
            ]
          },
          "docs": "UnscopeOrganizationToken removes the organization scope from a token. This\nendpoint is useful when a user wants to remove an organization: by\nunscoping the token first, the user can then delete the organization\nwithout invalidating his token."
        }
